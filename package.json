{
  "name": "openspeaks-archives",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSpeaks Archives: recordings made with speakers of Indigenous and endangered languages in South Asia.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.js",
    "build": "node scripts/build.js",
    "tome-sync": "node scripts/tome-sync.js",
    "serve": "cd dist && python3 -m http.server 8765 --bind 127.0.0.1",
    "push": "sh scripts/push.sh",
    "new": "node scripts/item.js new",
    "ia": "node scripts/item.js ia",
    "stage": "node scripts/item.js stage",
    "update": "node scripts/item.js update",
    "webm": "node scripts/item.js webm",
    "mint": "node scripts/authority.js mint"
  }
}
